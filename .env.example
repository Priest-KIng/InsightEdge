# App
APP_NAME=InsightEdge
APP_ENV=dev
API_PREFIX=/api
API_KEY=

# Retrieval and embedding
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
COLLECTION_NAME=insightedge_docs
TOP_K=4
MAX_SIMILARITY_DISTANCE=0.65
CHUNK_SIZE=1400
CHUNK_OVERLAP=280

# LLM
LLM_MODEL=phi3:mini
OLLAMA_BASE_URL=http://localhost:11434
LLM_TIMEOUT_SECONDS=180
LLM_CONTEXT_LENGTH=4096
LLM_MAX_OUTPUT_TOKENS=384
LLM_NUM_GPU=-1

# Ingest and storage
MAX_FILE_SIZE_MB=25
INGEST_BASE_DIR=backend/data/ingest
VECTOR_DB_DIR=backend/data/chroma
DATA_DIR=backend/data

# CORS
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
CORS_ALLOW_CREDENTIALS=false
