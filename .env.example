# App
APP_NAME=InsightEdge
APP_ENV=dev
API_PREFIX=/api
API_KEY=
DEFAULT_WORKSPACE_ID=default

# Retrieval and embedding
EMBEDDING_PROVIDER=sentence_transformers
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
COLLECTION_NAME=insightedge_docs
TOP_K=3
MAX_SIMILARITY_DISTANCE=0.65
RETRIEVAL_CANDIDATE_K=12
CHUNK_SIZE=1400
CHUNK_OVERLAP=280
ENABLE_RETRIEVAL_ROUTER=true
ENABLE_MODEL_ROUTER=true
GROUNDEDNESS_MIN_SCORE=0.22

# Optional retrieval features
ENABLE_HYDE=false
HYDE_MAX_CHARS=1500
ENABLE_MULTI_QUERY=false
MULTI_QUERY_COUNT=3
ENABLE_PARENT_DOCUMENT_RETRIEVAL=false
PARENT_DOCUMENT_MAX_CHARS=4000
ENABLE_SELF_RAG=false
SELF_RAG_MAX_FOLLOWUPS=1
CROSS_ENCODER_MODEL=
CROSS_ENCODER_TOP_N=8
CONTEXT_COMPRESSION_MAX_SENTENCES=4
CONTEXT_COMPRESSION_MAX_CHARS=900

# LLM
LLM_MODEL=phi3:mini
OLLAMA_BASE_URL=http://localhost:11434
LLM_TIMEOUT_SECONDS=180
LLM_CONTEXT_LENGTH=4096
LLM_MAX_OUTPUT_TOKENS=384
LLM_NUM_GPU=-1
ROUTER_SIMPLE_MODEL=phi3:mini
ROUTER_BALANCED_MODEL=phi3:mini
ROUTER_STRONG_MODEL=llama3.1:8b-instruct-q4_K_M
ROUTER_STRONG_NUM_GPU=0
SYSTEM_PROMPT=You are a private local assistant. Use only the provided context to answer.

# Ingest and storage
MAX_FILE_SIZE_MB=25
# These paths are relative to the backend working directory used in the setup guide.
INGEST_BASE_DIR=./data/ingest
VECTOR_DB_DIR=./data/chroma
DATA_DIR=./data
INGEST_MAX_WORKERS=4

# Optional vision assistance for image-heavy PDFs
ENABLE_VLM_PDF_ASSIST=false
VLM_MODEL=minicpm-v
VLM_MAX_PAGES=2
VLM_IMAGE_DPI=180

# CORS
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
CORS_ALLOW_CREDENTIALS=false
