# App
APP_NAME=InsightEdge
APP_ENV=dev
API_PREFIX=/api

# Retrieval and embedding
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
COLLECTION_NAME=insightedge_docs
TOP_K=4
MAX_SIMILARITY_DISTANCE=0.65
CHUNK_SIZE=1400
CHUNK_OVERLAP=280

# LLM
LLM_MODEL=llama3.1:8b-instruct-q4_K_M
OLLAMA_BASE_URL=http://localhost:11434

# Ingest and storage
MAX_FILE_SIZE_MB=25
INGEST_BASE_DIR=backend/data/ingest
VECTOR_DB_DIR=backend/data/chroma
DATA_DIR=backend/data

# CORS
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
CORS_ALLOW_CREDENTIALS=false
